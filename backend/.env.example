PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api

# Supabase PostgreSQL & Storage configuration
# When SUPABASE_URL or SUPABASE_ANON_KEY are empty, GramSetu automatically runs in safe persistent/in-memory demo mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Authentication
JWT_SECRET=gramsetu_production_jwt_secret_dev_techtrix26_key_98374
JWT_EXPIRES_IN=15m

# Gemini Bilingual Assistant API
GEMINI_API_KEY=

# Platform Parameters
DEMO_MODE=true
ENABLE_DEMO_RESET=true
MAX_UPLOAD_SIZE_MB=10
GEO_DISCREPANCY_THRESHOLD_KM=28
